# ─── Application ───────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ─── MySQL ─────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=email_scheduler
MYSQL_USER=root
MYSQL_PASSWORD=

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Elasticsearch ─────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ─── Google OAuth 2.0 ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ─── Session ───────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# ─── Slack OAuth ───────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URL=http://localhost:4000/api/slack/callback

# ─── Ethereal Email (SMTP) ─────────────────────────────────
# Create an account at https://ethereal.email or leave blank
# to auto-generate one on first startup.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ─── Worker / Queue Configuration ──────────────────────────
DEFAULT_WORKER_CONCURRENCY=5
DEFAULT_MIN_EMAIL_DELAY_MS=2000
DEFAULT_MAX_EMAILS_PER_HOUR=200

# ─── Job Retry Configuration ──────────────────────────────
EMAIL_JOB_ATTEMPTS=3
EMAIL_JOB_BACKOFF_MS=5000

# ─── Encryption (for stored SMTP credentials) ─────────────
ENCRYPTION_KEY=generate-a-32-byte-hex-key-here
